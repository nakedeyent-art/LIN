# Copy to .env.local
DATABASE_URL=postgres://lin:lin@localhost:5432/lin
# Public base URL used in emailed links (required in production)
APP_URL=http://localhost:3000
# Transactional email via Resend (required in production; without it dev mode prints emails to the server log)
RESEND_API_KEY=
MAIL_FROM="LIN <no-reply@your-domain.com>"
# Shared secret for the scheduled-jobs endpoint (min 16 chars). Generate with: openssl rand -hex 32
# The endpoint refuses to run without it. Schedule: GET/POST /api/cron/daily with "Authorization: Bearer <secret>"
CRON_SECRET=
