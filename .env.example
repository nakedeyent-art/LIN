# Copy to .env.local
DATABASE_URL=postgres://lin:lin@localhost:5432/lin
# Public base URL used in emailed links (required in production)
APP_URL=http://localhost:3000
# Transactional email via Resend (required in production; without it dev mode prints emails to the server log)
RESEND_API_KEY=
MAIL_FROM="LIN <no-reply@your-domain.com>"
# Shared secret for the scheduled-jobs endpoint (min 16 chars). Generate with: openssl rand -hex 32
# The endpoint refuses to run without it. Schedule: GET/POST /api/cron/daily with "Authorization: Bearer <secret>"
CRON_SECRET=

# ---- Payments (Stripe Connect) — leave STRIPE_SECRET_KEY empty to run with e-signature only (agreements don't move money) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee in basis points, taken from the athlete's payout (500 = 5%). 0 = no fee. Max 2000.
PLATFORM_FEE_BPS=0

# Two-factor authentication (all accounts): encrypts the authenticator seeds at rest. REQUIRED in production.
# Generate with: openssl rand -base64 32   (changing it makes existing TOTP seeds unreadable; preserve it securely)
MFA_ENCRYPTION_KEY=

# Abuse controls: set TRUST_PROXY=1 ONLY behind a proxy that overwrites X-Forwarded-For; otherwise rate limits key on a shared bucket.
TRUST_PROXY=
# Upload malware scanning. "clamav://host:3310" scans via ClamAV INSTREAM and fails closed if the scanner is unreachable. Empty = scanning disabled.
UPLOAD_SCANNER=
# Asynchronous malware scanning: "async" accepts uploads into quarantine and the scheduled "upload-scan" job releases them once clean (needs UPLOAD_SCANNER).
# Default (empty) scans inline and refuses bad files immediately.
UPLOAD_SCAN_MODE=

# ---- Private object storage (S3-compatible). Leave empty to keep files in Postgres. All four must be set together; files are never public. ----
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# "0" for virtual-hosted-style bucket URLs; default is path-style (works with MinIO and most S3 clones).
OBJECT_STORAGE_PATH_STYLE=
